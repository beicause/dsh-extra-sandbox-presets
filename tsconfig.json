{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    // The sources are JavaScript with JSDoc types; the declaration module
    // src/contracts.d.ts carries the shapes JSDoc states poorly. Checking is
    // the whole job here: the package runs from source, so nothing is emitted.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    // The DSH packages are installed in this workspace through symlinks. Keeping
    // symlinked paths unresolvable-as-real keeps declared types portable: they
    // name '@deepseek-ai/...' instead of a store path.
    "preserveSymlinks": true
  },
  "include": ["src", "test"]
}
